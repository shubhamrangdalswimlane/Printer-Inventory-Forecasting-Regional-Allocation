<?xml version="1.0" encoding="UTF-8"?>
<!--
  backend/app/pom.xml - build file for "pifa-app", the runnable Spring Boot application.
  It depends on pifa-rules and packages everything into one executable jar
  (backend/app/target/pifa-app-*.jar), run with: java -jar pifa-app-*.jar
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pifa</groupId>
    <artifactId>pifa-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>pifa-app</artifactId>
  <name>pifa-app</name>

  <dependencies>
    <!-- Our own Drools rules module. -->
    <dependency>
      <groupId>com.pifa</groupId>
      <artifactId>pifa-rules</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- REST controllers + embedded Tomcat web server. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Spring Security core (filters, method security). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- Validates Keycloak JWTs sent as bearer tokens. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- Health and info endpoints for Kubernetes probes and monitoring. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Prometheus metrics endpoint (/actuator/prometheus on the internal management port). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- AWS SDK v2 S3 client: the object store for original files (AWS S3 or MinIO); see S3FileStore. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>2.29.6</version>
    </dependency>
    <!-- JPA/Hibernate for database access (used from Phase 1). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Flyway: versioned database migrations; the postgresql module adds PostgreSQL 16 support. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- PostgreSQL JDBC driver. Compile scope because LiveEvents uses its LISTEN/NOTIFY API (PGConnection). -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <!-- JavaMail support for notification e-mails (sent from the outbox). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- Apache POI: reads and writes .xlsx files (ingestion, exports, templates, synthetic data). -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.4.0</version>
    </dependency>
    <!-- JSch (maintained fork): SFTP client used by the ingestion poller. -->
    <dependency>
      <groupId>com.github.mwiede</groupId>
      <artifactId>jsch</artifactId>
      <version>0.2.20</version>
    </dependency>
    <!-- Generates the OpenAPI 3 description and Swagger UI at /swagger-ui.html. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <!-- 2.8.x is the line built for Spring Boot 3.4/3.5; 2.6.x targets Boot 3.3. -->
      <version>2.8.9</version>
    </dependency>

    <!-- Test-only dependencies (JUnit 5, Mockito, MockMvc, AssertJ; security test helpers). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- jqwik: property-based tests (random inputs, checked invariants) for the allocation arithmetic. -->
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <version>1.9.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Repackages the jar into an executable "fat jar" containing all dependencies. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
