// =============================================================================
// workflow.drl  -  package pifa.rules.workflow
//
// Purpose : transition guard rules. A guard decides whether a workflow action may happen.
// Input   : one PublishCheck fact (publish) or one WorkflowCheck fact (approve, finalize region, final).
// Output  : Violation objects appended to the global list "violations"; any ERROR blocks the action.
// =============================================================================
package pifa.rules.workflow;

import com.pifa.rules.model.*;

global java.util.List violations;

// BR-WF-01 (a): publishing needs an active forecast version.
rule "BR-WF-01 no active forecast"
when
    PublishCheck( hasActiveForecast == false )
then
    violations.add( Violation.error( "BR-WF-01", 0, null, "There is no active forecast version to publish" ) );
end

// BR-WF-01 (b): publishing is blocked while the forecast has blocking validation errors.
rule "BR-WF-01 forecast has errors"
when
    PublishCheck( hasActiveForecast == true, errorCount > 0, $n : errorCount )
then
    violations.add( Violation.error( "BR-WF-01", 0, null, "The forecast has " + $n + " blocking validation error(s)" ) );
end

// BR-WF-02: approving the allocation needs an active inventory version ...
rule "BR-WF-02 no active inventory"
when
    WorkflowCheck( action == "APPROVE_ALLOCATION", hasActiveInventory == false )
then
    violations.add( Violation.error( "BR-WF-02", 0, null, "There is no active inventory version" ) );
end

// ... a generated proposal ...
rule "BR-WF-02 no proposal"
when
    WorkflowCheck( action == "APPROVE_ALLOCATION", hasProposal == false )
then
    violations.add( Violation.error( "BR-WF-02", 0, null, "Generate the allocation proposal first" ) );
end

// ... and no model breaking BR-VA-01/02.
rule "BR-WF-02 allocation has errors"
when
    WorkflowCheck( action == "APPROVE_ALLOCATION", allocationErrors > 0, $n : allocationErrors )
then
    violations.add( Violation.error( "BR-WF-02", 0, null, "The allocation has " + $n + " blocking error(s) (for example more than the allocatable stock)" ) );
end

// BR-WF-03 (a): a region cannot finalize while it has pending transfers.
rule "BR-WF-03 region has pending transfers"
when
    WorkflowCheck( action == "FINALIZE_REGION", pendingTransfers > 0, $r : region, $n : pendingTransfers )
then
    violations.add( Violation.error( "BR-WF-03", 0, $r, $r + " has " + $n + " pending transfer(s); accept, reject or cancel them first" ) );
end

// BR-WF-03 (b): the cycle becomes FINAL only when every region is finalized ...
rule "BR-WF-03 not all regions finalized"
when
    WorkflowCheck( action == "FINAL", allRegionsFinalized == false )
then
    violations.add( Violation.error( "BR-WF-03", 0, null, "Not every region is finalized" ) );
end

// ... no transfer is pending ...
rule "BR-WF-03 transfers pending"
when
    WorkflowCheck( action == "FINAL", pendingTransfers > 0, $n : pendingTransfers )
then
    violations.add( Violation.error( "BR-WF-03", 0, null, $n + " transfer(s) are still pending" ) );
end

// ... and the final numbers are valid (BR-VA-01/02).
rule "BR-WF-03 final allocation has errors"
when
    WorkflowCheck( action == "FINAL", allocationErrors > 0, $n : allocationErrors )
then
    violations.add( Violation.error( "BR-WF-03", 0, null, "The final allocation has " + $n + " blocking error(s)" ) );
end
