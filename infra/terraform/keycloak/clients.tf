# Purpose: the four PIFA clients and their protocol mappers / service-account roles (architecture.md 6.1).
# Same client IDs as the dev JSON realm so the SPA and API configuration differ per environment only in URLs.

# ---------------------------------------------------------------------------------------------------------------
# pifa-api: the resource server. It never logs anyone in; it only validates tokens whose aud contains pifa-api.
# BEARER-ONLY maps to Keycloak's bearerOnly flag (no flows at all, no secret is needed for token validation).
# ---------------------------------------------------------------------------------------------------------------
resource "keycloak_openid_client" "api" {
  realm_id    = keycloak_realm.this.id
  client_id   = "pifa-api"
  name        = "PIFA API (resource)"
  enabled     = true
  access_type = "BEARER-ONLY"

  standard_flow_enabled        = false
  implicit_flow_enabled        = false
  direct_access_grants_enabled = false
  service_accounts_enabled     = false
}

# ---------------------------------------------------------------------------------------------------------------
# pifa-web: the React SPA. Public client (a browser cannot keep a secret), so PKCE S256 is what protects the
# authorization code. Exact redirect URIs only, CORS limited to the app origin, no password grant, no implicit flow.
# ---------------------------------------------------------------------------------------------------------------
resource "keycloak_openid_client" "web" {
  realm_id    = keycloak_realm.this.id
  client_id   = "pifa-web"
  name        = "PIFA web app"
  enabled     = true
  access_type = "PUBLIC"

  standard_flow_enabled        = true
  implicit_flow_enabled        = false
  direct_access_grants_enabled = false
  service_accounts_enabled     = false
  pkce_code_challenge_method   = "S256"

  valid_redirect_uris             = var.web_redirect_uris
  valid_post_logout_redirect_uris = var.web_post_logout_redirect_uris
  web_origins                     = var.web_origins

  consent_required            = false
  frontchannel_logout_enabled = true

  # Only roles explicitly scope-mapped below end up in tokens (least privilege), not every role in the realm.
  full_scope_allowed = false
}

# Put the four business roles (and nothing else) into pifa-web tokens.
resource "keycloak_generic_role_mapper" "web_realm_roles" {
  for_each  = keycloak_role.realm
  realm_id  = keycloak_realm.this.id
  client_id = keycloak_openid_client.web.id
  role_id   = each.value.id
}

# Remove the optional client scopes (including offline_access): pifa-web must never get offline tokens.
resource "keycloak_openid_client_optional_scopes" "web" {
  realm_id        = keycloak_realm.this.id
  client_id       = keycloak_openid_client.web.id
  optional_scopes = []
}

# regions user attribute -> multi-valued "regions" claim; the API turns it into the RegionScope (architecture 6.2).
resource "keycloak_openid_user_attribute_protocol_mapper" "web_regions" {
  realm_id  = keycloak_realm.this.id
  client_id = keycloak_openid_client.web.id
  name      = "regions"

  user_attribute   = "regions"
  claim_name       = "regions"
  claim_value_type = "String"
  multivalued      = true

  add_to_access_token = true
  add_to_id_token     = true
  add_to_userinfo     = true
}

# Adds pifa-api to aud, so the API can reject tokens that were not issued for it (audience check in Spring Security).
resource "keycloak_openid_audience_protocol_mapper" "web_api_audience" {
  realm_id  = keycloak_realm.this.id
  client_id = keycloak_openid_client.web.id
  name      = "pifa-api-audience"

  included_client_audience = keycloak_openid_client.api.client_id
  add_to_access_token      = true
  add_to_id_token          = false
}

# ---------------------------------------------------------------------------------------------------------------
# pifa-automation: confidential client-credentials client for CI smoke tests and future system integrations.
# No realm roles by default; grant only what a given smoke test needs. Its secret is generated by Keycloak, read
# from the sensitive output by CI and stored in Secrets Manager (pifa/<env>/keycloak/pifa-automation-secret).
# ---------------------------------------------------------------------------------------------------------------
resource "keycloak_openid_client" "automation" {
  realm_id    = keycloak_realm.this.id
  client_id   = "pifa-automation"
  name        = "PIFA automation (CI smoke tests)"
  enabled     = true
  access_type = "CONFIDENTIAL"

  standard_flow_enabled        = false
  implicit_flow_enabled        = false
  direct_access_grants_enabled = false
  service_accounts_enabled     = true
  full_scope_allowed           = false
}

resource "keycloak_openid_audience_protocol_mapper" "automation_api_audience" {
  realm_id  = keycloak_realm.this.id
  client_id = keycloak_openid_client.automation.id
  name      = "pifa-api-audience"

  included_client_audience = keycloak_openid_client.api.client_id
  add_to_access_token      = true
  add_to_id_token          = false
}

# ---------------------------------------------------------------------------------------------------------------
# pifa-admin-reader: the API uses this service account to list users and login events for the Admin dashboard.
# It gets exactly two realm-management roles, both read-only: view-users and view-events. No manage-* roles,
# so a leaked secret cannot create users, change roles or reset passwords.
# ---------------------------------------------------------------------------------------------------------------
resource "keycloak_openid_client" "admin_reader" {
  realm_id    = keycloak_realm.this.id
  client_id   = "pifa-admin-reader"
  name        = "PIFA admin reader (read-only users view)"
  enabled     = true
  access_type = "CONFIDENTIAL"

  standard_flow_enabled        = false
  implicit_flow_enabled        = false
  direct_access_grants_enabled = false
  service_accounts_enabled     = true
}

data "keycloak_openid_client" "realm_management" {
  realm_id  = keycloak_realm.this.id
  client_id = "realm-management"
}

resource "keycloak_openid_client_service_account_role" "admin_reader" {
  for_each = toset(["view-users", "view-events"])

  realm_id                = keycloak_realm.this.id
  service_account_user_id = keycloak_openid_client.admin_reader.service_account_user_id
  client_id               = data.keycloak_openid_client.realm_management.id
  role                    = each.value
}
